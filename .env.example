# ============================================================
# VidaQR — Variables de entorno
# Copiá este archivo como .env y completá los valores reales.
# NUNCA subas el archivo .env al repositorio.
# ============================================================

# ---- Flask ----
# Clave secreta para sesiones y CSRF. Generá una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET=cambia-esto-en-produccion

# URL base de la app (sin barra final). Usada en links de emails.
APP_BASE_URL=https://vidaqr.com.ar

# ---- Base de datos MySQL (Railway las provee automáticamente) ----
MYSQLHOST=localhost
MYSQLPORT=3306
MYSQLDATABASE=railway
MYSQLUSER=root
MYSQLPASSWORD=

# ---- Alternativa local (si no usás Railway) ----
# QR_DB_HOST=127.0.0.1
# QR_DB_PORT=3306
# QR_DB_NAME=vidaqr
# QR_DB_USER=root
# QR_DB_PASSWORD=

# ---- Email transaccional (Brevo SMTP relay) ----
# Registrate gratis en https://www.brevo.com
# SMTP → Configuración → Credenciales SMTP
MAIL_SERVER=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=tu@email.com
# Usá la API Key de Brevo como contraseña SMTP (no tu contraseña de cuenta)
MAIL_PASSWORD=xsmtpsib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Dirección remitente visible en los emails
MAIL_FROM=noreply@vidaqr.com.ar
